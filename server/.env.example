# Copy to .env and fill in values
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# Optional: point to a real MongoDB (Atlas/local). If empty, an embedded MongoDB is used with a persistent data dir.
MONGODB_URI=

# Google Gemini AI (keep on the server only; NEVER expose to the frontend)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
